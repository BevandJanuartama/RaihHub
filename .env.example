PORT=5000
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Gemini API (Google AI Studio): dipakai untuk ekstraksi, parsing CV, dan embedding. Wajib.
GEMINI_API_KEY=
# Rantai model: dicoba berurutan, model yang overload (503/429) di-skip 10 menit
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.8-flash
GEMINI_TIMEOUT_MS=60000
GEMINI_EMBED_MODEL=gemini-embedding-001
# AI_EXTRACT=off   # matikan ekstraksi AI sementara
# EMBEDDINGS=off   # matikan embedding (feed pakai tag scoring saja)

# Discovery: tanpa key otomatis pakai pencarian gratis (DuckDuckGo). Key di bawah opsional.
# FREE_SEARCH=off   # matikan pencarian gratis
SERPER_API_KEY=
BRAVE_API_KEY=

# Jadwal & perilaku
CRON_SCHEDULE=0 */12 * * *
RUN_ON_START=true
CORS_ORIGIN=http://localhost:3000
MAX_RESULTS=300
PAGES_PER_DOMAIN=12
PAGES_PER_DISCOVERED=3
DELAY_MS=1500
